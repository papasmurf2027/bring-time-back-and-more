# Copy to .env for local runs. On Railway, set these in the service Variables tab.
# Railway provides DATABASE_URL automatically when you add a Postgres service.
# Do NOT commit a real .env.
PORT=3000
DATABASE_URL=
# Local only: if DATABASE_URL is empty, the server uses a local SQLite file (data.db).
# Pre-launch / test mode is ON by default. Set to false only when real payments + LLC are ready.
PRELAUNCH=true
